{{#if missing}}
<div class="jeli-empty">
  <i class="fa-solid fa-link-slash"></i>
  <p>{{localize 'JELI.Management.Missing'}}</p>
  <p class="notes"><code>{{setId}}</code></p>
</div>
{{else}}
<div class="jeli-management">
  <header class="jeli-management-header">
    <img class="jeli-set-img" src="{{set.img}}" alt="">
    <div class="jeli-management-identity">
      <h2>{{set.name}}</h2>
      {{#if set.description}}<p class="jeli-set-desc">{{set.description}}</p>{{/if}}
      <div class="jeli-meta">
        <span class="jeli-status jeli-status-{{status}}">{{statusLabel}}</span>
        {{#if grantId}}<span><i class="fa-solid fa-hashtag"></i> <code>{{grantId}}</code></span>{{/if}}
        <span title="{{localize 'JELI.Management.Updated'}}"><i class="fa-regular fa-clock"></i> {{updatedLabel}}</span>
        <span title="{{localize 'JELI.Management.Activated'}}"><i class="fa-solid fa-bolt"></i> {{activatedLabel}}</span>
      </div>
    </div>
  </header>

  <div class="jeli-management-body">
    {{#if hasActiveGrant}}
    <div class="jeli-banner info">
      <i class="fa-solid fa-link"></i>
      <span>{{localize 'JELI.Management.ActiveNotice'}}</span>
    </div>
    {{else}}
    <div class="jeli-banner">
      <i class="fa-solid fa-circle-info"></i>
      <span>{{localize 'JELI.Management.InactiveNotice'}}</span>
    </div>
    {{/if}}

    {{#if missingCount}}
    <div class="jeli-banner warning">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <span>{{localize 'JELI.Management.MissingNotice' count=missingCount}}</span>
    </div>
    {{/if}}

    <section class="jeli-management-section">
      <header class="jeli-panel-header">
        <h3><i class="fa-solid fa-cubes"></i> {{localize 'JELI.Editor.Objects'}} <span class="jeli-badge">{{objectCount}}</span></h3>
      </header>
      {{#if hasObjects}}
      <table class="jeli-table">
        <thead>
          <tr>
            <th>{{localize 'JELI.Management.Object'}}</th>
            <th>{{localize 'JELI.Management.Type'}}</th>
            <th>{{localize 'JELI.Management.Distributed'}}</th>
            <th>{{localize 'JELI.Management.Problems'}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each objects}}
          <tr>
            <td class="jeli-cell-actor"><img src="{{img}}" alt=""> {{name}}</td>
            <td>{{typeLabel}}</td>
            <td>{{granted}} / {{total}}</td>
            <td>{{#if problems}}<span class="jeli-result jeli-result-partial">{{problems}}</span>{{else}}—{{/if}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="notes">{{localize 'JELI.Management.NoObjects'}}</p>
      {{/if}}
    </section>

    <section class="jeli-management-section">
      <header class="jeli-panel-header">
        <h3><i class="fa-solid fa-users"></i> {{localize 'JELI.Editor.Recipients'}} <span class="jeli-badge">{{recipientCount}}</span></h3>
      </header>
      {{#if hasRecipients}}
      <table class="jeli-table">
        <thead>
          <tr>
            <th>{{localize 'JELI.Management.Recipient'}}</th>
            <th>{{localize 'JELI.Management.Status'}}</th>
            <th>{{localize 'JELI.Management.Granted'}}</th>
            <th>{{localize 'JELI.Management.Problems'}}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each recipients}}
          <tr data-actor-uuid="{{uuid}}" data-actor-name="{{name}}">
            <td class="jeli-cell-actor"><img src="{{img}}" alt=""> {{name}}</td>
            <td><span class="jeli-status jeli-status-{{status}}">{{statusLabel}}</span></td>
            <td>{{granted}} / {{total}}</td>
            <td>{{#if problemCount}}<span class="jeli-result jeli-result-partial">{{problemCount}}</span>{{else}}—{{/if}}</td>
            <td class="jeli-cell-actions">
              <button type="button" class="jeli-button small danger" data-action="revokeRecipient" data-actor-uuid="{{uuid}}" {{#unless canRevoke}}disabled{{/unless}}>
                {{localize 'JELI.Action.Revoke'}}
              </button>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="notes">{{localize 'JELI.Management.NoRecipients'}}</p>
      {{/if}}
    </section>

    <section class="jeli-management-section">
      <header class="jeli-panel-header">
        <h3><i class="fa-solid fa-clock-rotate-left"></i> {{localize 'JELI.Management.LastSync'}}</h3>
      </header>
      {{#if lastSyncAt}}
      <p>
        <span class="notes">{{lastSyncLabel}}</span>
        <span class="jeli-sync-summary">{{lastSyncSummary}}</span>
      </p>
      {{#if lastSyncErrors.length}}
      <ul class="jeli-error-list">
        {{#each lastSyncErrors}}<li>{{this}}</li>{{/each}}
      </ul>
      {{/if}}
      {{else}}
      <p class="notes">{{localize 'JELI.Management.NeverSynced'}}</p>
      {{/if}}
    </section>
  </div>

  <footer class="jeli-editor-footer">
    <span class="notes">{{localize 'JELI.Management.FooterHint'}}</span>
    <div class="jeli-row-actions">
      <button type="button" class="jeli-button" data-action="copyLink">
        <i class="fa-solid fa-link"></i> {{localize 'JELI.Action.CopyLink'}}
      </button>
      <button type="button" class="jeli-button" data-action="editSet">
        <i class="fa-solid fa-pen"></i> {{localize 'JELI.Action.Edit'}}
      </button>
      <button type="button" class="jeli-button" data-action="activate" {{#unless canActivate}}disabled{{/unless}}>
        <i class="fa-solid fa-bolt"></i> {{localize 'JELI.Action.Activate'}}
      </button>
      <button type="button" class="jeli-button" data-action="synchronize" {{#unless hasActiveGrant}}disabled{{/unless}}>
        <i class="fa-solid fa-arrows-rotate"></i> {{localize 'JELI.Action.Synchronize'}}
      </button>
      <button type="button" class="jeli-button danger" data-action="revokeSet" {{#unless hasActiveGrant}}disabled{{/unless}}>
        <i class="fa-solid fa-rotate-left"></i> {{localize 'JELI.Management.RevokeSet'}}
      </button>
      <button type="button" class="jeli-button" data-action="close">{{localize 'JELI.Common.Close'}}</button>
    </div>
  </footer>
</div>
{{/if}}
